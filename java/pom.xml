<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.theforgotten-dev</groupId>
  <artifactId>tspr3</artifactId><version>0.1.0</version>
  <name>TSPR3</name>
  <description>Triadic ordering, compact frequencies and block-prefix indexing for signed integers.</description>
  <url>${tspr3.repository.url}</url>
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-10-13T00:00:00Z</project.build.outputTimestamp>
    <tspr3.repository.url>https://github.com/theforgotten-dev/tspr3</tspr3.repository.url>
    <tspr3.license.name>Apache License, Version 2.0</tspr3.license.name>
    <tspr3.license.url>https://www.apache.org/licenses/LICENSE-2.0</tspr3.license.url>
    <tspr3.namespace.verified>false</tspr3.namespace.verified>
  </properties>
  <licenses><license><name>${tspr3.license.name}</name><url>${tspr3.license.url}</url></license></licenses>
  <developers><developer><id>theforgotten-dev</id><name>theforgotten-dev</name><url>https://github.com/theforgotten-dev</url></developer></developers>
  <scm><connection>scm:git:${tspr3.repository.url}.git</connection><developerConnection>scm:git:${tspr3.repository.url}.git</developerConnection><url>${tspr3.repository.url}</url><tag>v0.1.0</tag></scm>
  <build><resources><resource><directory>../</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include><include>NOTICE</include></includes></resource></resources><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><showWarnings>true</showWarnings><failOnWarning>true</failOnWarning><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><skip>true</skip></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version><executions><execution><id>algorithm-contract-tests</id><phase>test</phase><goals><goal>run</goal></goals><configuration><target><java classname="org.tspr3.Tspr3Test" fork="true" failonerror="true"><classpath><pathelement location="${project.build.testOutputDirectory}"/><pathelement location="${project.build.outputDirectory}"/></classpath><jvmarg value="-Xmx1g"/></java></target></configuration></execution></executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version><executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.6.3</version><configuration><doclint>all</doclint></configuration><executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions></plugin>
  </plugins></build>
  <profiles><profile><id>central-release</id><build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version><executions><execution><id>release-metadata</id><phase>validate</phase><goals><goal>enforce</goal></goals><configuration><rules>
      <requireProperty><property>tspr3.license.name</property><regex>^(?!UNSPECIFIED$).+</regex><message>Select a distribution license before releasing.</message></requireProperty>
      <requireProperty><property>tspr3.license.url</property><regex>^https://.+</regex><message>Provide the license URL.</message></requireProperty>
      <requireProperty><property>tspr3.namespace.verified</property><regex>^true$</regex><message>Verify your namespace in Sonatype Central first.</message></requireProperty>
    </rules></configuration></execution></executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.7</version><configuration><bestPractices>true</bestPractices></configuration><executions><execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions></plugin>
    <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.11.1</version><extensions>true</extensions><configuration><publishingServerId>central-publisher</publishingServerId><autoPublish>false</autoPublish></configuration></plugin>
  </plugins></build></profile></profiles>
</project>
